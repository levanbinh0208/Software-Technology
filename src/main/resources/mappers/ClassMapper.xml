<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.example.residential_management.mapper.ClassMapper">

    <resultMap id="ClassResultMap" type="com.example.residential_management.entity.Classes">
        <id column="ClassId" property="classId"/>
        <result column="ClassName" property="className"/>
        <result column="Grade" property="grade"/>
        <result column="Description" property="description"/>

    </resultMap>

    <select id="findAll" resultMap="ClassResultMap">
        SELECT
            ClassId,
            ClassName,
            Grade,
            Description
        FROM Classes
        ORDER BY Grade, ClassName
    </select>

</mapper>
